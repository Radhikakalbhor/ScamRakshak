{
  "version": 2,
  "note": "Transcript and phrases are normalized the same way (lowercase, punctuation -> space, collapsed spaces, Devanagari nukta removed). Phrases match whole words; a trailing * lets the last word continue (otp bata* = bataiye/batao/batana). 'phrases' maps weight -> list. Each distinct phrase counts once; overlapping phrases count only the longest. Type score = min(cap, sum of matched weights); total = sum of type scores; high >= levels.high, medium >= levels.medium. In negatable rules a phrase right after a negator (never share the otp) is ignored.",
  "levels": {"high": 6, "medium": 3},
  "negators": ["never", "not", "dont", "don", "doesn", "didn", "won", "cannot", "cant"],
  "negation_window": 3,
  "rules": [
    {"type": "fake_kyc", "cap": 4, "phrases": {
      "3": ["kyc update*", "kyc expire*", "kyc band*", "account will be blocked", "account block ho*", "account band ho*",
            "card will be blocked", "card block ho*", "netbanking suspend*", "account suspend ho*",
            "केवाईसी अपडेट", "खाता बंद", "खाता ब्लॉक", "अकाउंट ब्लॉक", "अकाउंट बंद"],
      "2": ["kyc", "pan card link*", "account freeze*", "head office se bol*", "aadhaar link nahi",
            "केवाईसी", "कार्ड बंद", "खाता फ्रीज़", "हेड ऑफिस से"]}},

    {"type": "otp_request", "cap": 6, "negatable": true, "phrases": {
      "3": ["tell me the otp", "share the otp", "share otp", "read the otp", "read out the code", "otp bata*", "otp bol*",
            "otp share kar*", "otp de do", "otp dijiye", "code bata*", "code bol*", "ओटीपी बता*", "otp बता*", "कोड बता*",
            "ओटीपी शेयर", "ओटीपी दे*"],
      "2": ["6 digit code", "six digit code", "code that came", "code aaya hoga", "jo code aaya", "जो कोड आया", "छह अंकों का कोड"]}},

    {"type": "remote_access", "cap": 6, "negatable": true, "phrases": {
      "3": ["anydesk", "any desk", "teamviewer", "team viewer", "quicksupport", "quick support app", "rustdesk",
            "share your screen", "screen share kar*", "screen sharing app", "एनीडेस्क", "टीमव्यूअर", "स्क्रीन शेयर"],
      "2": ["download this app", "install this app", "app download kar*", "app install kar*", "ऐप डाउनलोड कर*", "ऐप इंस्टॉल कर*"]}},

    {"type": "digital_arrest", "cap": 8, "phrases": {
      "4": ["digital arrest", "डिजिटल अरेस्ट"],
      "3": ["arrest warrant", "money laundering", "stay on video call", "video call pe rah*", "video call par rah*",
            "मनी लॉन्ड्रिंग", "वीडियो कॉल पर रह*"],
      "2": ["cbi", "crime branch", "narcotics", "drugs parcel", "drugs mile", "drugs found", "fir registered", "fir darj",
            "ed notice", "supreme court order", "सीबीआई", "गिरफ्तार", "वारंट", "क्राइम ब्रांच", "ड्रग्स मिले"],
      "1": ["cyber cell", "केस दर्ज"]}},

    {"type": "courier_customs", "cap": 6, "phrases": {
      "3": ["parcel seized", "parcel has been seized", "seized by customs", "illegal items", "customs clearance fee",
            "parcel pakda*", "पार्सल पकड़ा", "अवैध सामान"],
      "2": ["fake passports", "customs duty", "parcel ruk*", "पार्सल रोका", "कस्टम ड्यूटी"],
      "1": ["customs", "fedex", "dhl", "कस्टम"]}},

    {"type": "lottery_prize", "cap": 6, "phrases": {
      "3": ["lottery lagi", "lottery laga", "inaam jeet*", "you have won a", "लॉटरी लगी", "इनाम जीत*"],
      "2": ["lucky draw", "you have won", "kbc", "prize money", "registration fee", "processing fee", "aapne jeet*",
            "लकी ड्रॉ", "आपने जीत*", "रजिस्ट्रेशन शुल्क", "प्रोसेसिंग फीस"],
      "1": ["lottery", "लॉटरी"]}},

    {"type": "loan_threat", "cap": 6, "phrases": {
      "3": ["photo viral", "morphed photo", "send to your contacts", "contacts ko bhej*", "sabko photo bhej*",
            "फोटो वायरल", "रिश्तेदारों को भेज*", "कॉन्टैक्ट्स को भेज*"],
      "2": ["badnaam", "contact list", "photo edit kar*", "loan overdue", "बदनाम"],
