                         "कार्ड नंबर", "खाता नंबर", "अकाउंट नंबर", "आधार नंबर", "पैन नंबर", "केवाईसी नंबर"],
    "pretexts": ["bank", "sbi", "hdfc", "icici", "axis", "rbi", "kyc", "head office", "customer care", "police", "cbi",
