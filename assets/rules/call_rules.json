{
  "version": 2,
  "note": "Transcript and phrases are normalized the same way (lowercase, punctuation -> space, collapsed spaces, Devanagari nukta removed). Phrases match whole words; a trailing * lets the last word continue (otp bata* = bataiye/batao/batana). 'phrases' maps weight -> list. Each distinct phrase counts once; overlapping phrases count only the longest. Type score = min(cap, sum of matched weights); total = sum of type scores; high >= levels.high, medium >= levels.medium. In negatable rules a phrase right after a negator (never share the otp) is ignored.",
  "levels": {"high": 6, "medium": 3},
  "negators": ["never", "not", "dont", "don", "doesn", "didn", "won", "cannot", "cant"],
  "negation_window": 3,
  "intents": {
    "note": "Caller REQUEST near a SENSITIVE ITEM (lib/engine/call_intent.dart). Tokens are normalized like the live analyzer (Devanagari folding); an item also matches up to 3 joined tokens, so 'o t p', 'o.t.p' and 'ओ टी पी' equal 'otp'. A trailing * is a prefix. A request needs a verb within 'window' tokens (either side) of an item, no negator within 3 tokens before / 2 after the verb or right before the item, and no first-person speaker right before the verb ('we will send you an OTP'). Secret request (OTP/PIN/CVV/password) scores 'secret_weight' under otp_request; identifier request (card/account/Aadhaar/PAN/KYC number) scores 'identifier_weight' under details_request; if any request exists, a pretext word anywhere in the call adds 'pretext_weight' under impersonation.",
    "window": 8,
    "secret_weight": 4,
    "identifier_weight": 3,
    "pretext_weight": 3,
    "request_verbs": ["give", "share", "tell", "send", "read", "provide", "say", "speak", "forward", "confirm", "dictate",
                      "bata", "batao", "bataiye", "bataye", "batayiye", "batayen", "batana", "batado", "bolo", "boliye", "bol do",
                      "de do", "de dijiye", "de dena", "dedo", "dijiye", "dijie", "dena", "dein", "bhejo", "bhejiye", "bhej do",
                      "padho", "padhiye", "sunaiye", "share karo", "share kijiye", "share kariye",
                      "बताइए", "बताइये", "बताओ", "बता", "बताना", "बताएं", "बताएँ", "बोलिए", "बोलो", "दीजिए", "दीजिये", "दे दो", "देना", "दें",
                      "भेजिए", "भेजो", "भेज", "शेयर", "साझा", "पढ़िए", "पढ़ो", "सुनाइए"],
    "demand_verbs": ["need", "want", "require", "required", "needed", "chahiye", "chaiye", "chahie", "चाहिए", "चाहिये",
                     "do you have", "kya hai"],
    "aliases": {"otp": ["otb", "otpee", "o tee pee", "ओ टी पी", "ओटिपी"], "kyc": ["kic", "kayc", "kay why see", "के वाई सी"],
                "cvv": ["cvb", "सी वी वी"], "pin": ["पिन"]},
    "fuzzy_short": ["otp", "kyc", "cvv"],
    "negators": ["never", "not", "dont", "don", "no", "nobody", "cannot", "cant", "nahi", "nahin", "mat", "na", "kabhi",
                 "मत", "न", "ना", "नहीं", "कभी"],
    "self_speakers": ["i", "we", "hum", "main", "maine", "humne", "मैं", "हम", "मैंने", "हमने"],
    "secret_items": ["otp*", "one time password", "verification code", "security code", "sms code", "digit code", "code",
                     "pin", "upi pin", "atm pin", "mpin", "m pin", "cvv*", "password*", "net banking password",
                     "ओटीपी", "पिन", "सीवीवी", "पासवर्ड", "कोड"],
    "not_secret_before": ["pin", "qr", "promo", "coupon", "discount", "postal", "zip", "area", "std", "ifsc", "referral", "पिन"],
    "not_secret_after": ["code", "कोड"],
    "identifier_items": ["card number", "card no", "account number", "account no", "aadhaar number", "aadhar number",
                         "aadhaar", "aadhar", "pan number", "pan card number", "kyc number", "kyc details", "expiry date",
                         "bank details", "account details", "card details", "banking details", "passbook", "net banking",
