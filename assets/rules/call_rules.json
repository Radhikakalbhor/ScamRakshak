      "2": ["trai", "press 9", "9 dabaye", "ट्राई", "9 दबाएं"]}},

    {"type": "electricity_bill", "cap": 4, "phrases": {
      "3": ["electricity will be cut", "connection will be disconnected", "bijli kat*", "light kat*", "बिजली काट*", "कनेक्शन कट*"],
      "2": ["bill not updated", "बिल अपडेट नहीं"]}},

    {"type": "upi_collect", "cap": 6, "negatable": true, "phrases": {
      "3": ["enter your pin", "enter upi pin", "pin daal*", "accept the request", "collect request", "scan the qr",
            "qr scan kar*", "पिन डाल*", "रिक्वेस्ट स्वीकार", "क्यूआर स्कैन"],
      "2": ["army se hu", "army se hoon"]}},

    {"type": "pressure", "cap": 2, "phrases": {
      "1": ["urgent", "immediately", "right now", "do not tell anyone", "don't tell anyone", "kisi ko mat batana",
            "turant", "jaldi karo", "abhi ke abhi", "do not cut the call", "call mat kaatna", "stay on the line",
            "तुरंत", "किसी को मत बताना", "किसी को न बताएं", "फोन मत काटना", "कॉल न काटें", "अभी के अभी"]}}
  ]
